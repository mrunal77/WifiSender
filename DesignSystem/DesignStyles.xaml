<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- TYPOGRAPHY                                                      -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="Inter, SF Pro Display, Segoe UI, Roboto, sans-serif"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>

  <Style Selector="TextBlock.HeroTitle">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="-0.3"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>

  <Style Selector="TextBlock.HeroSubtitle">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>

  <Style Selector="TextBlock.Heading">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="-0.1"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>

  <Style Selector="TextBlock.Caption">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>

  <Style Selector="TextBlock.Small">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>

  <Style Selector="TextBlock.BadgeText">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="0.5"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- CARDS & CONTAINERS                                              -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Card}"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.Inset">
    <Setter Property="Background" Value="{DynamicResource SurfaceInset}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Inset}"/>
    <Setter Property="Padding" Value="10"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.GlassCard">
    <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Card}"/>
    <Setter Property="Padding" Value="16"/>
  </Style>

  <Style Selector="Border.Warning">
    <Setter Property="Background" Value="{DynamicResource WarningContainer}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Inset}"/>
    <Setter Property="Padding" Value="12,10"/>
  </Style>

  <Style Selector="Border.StatusDot">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Background" Value="{StaticResource Color.BrandEmerald}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- BUTTONS                                                         -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="Inter, sans-serif"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>

  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{StaticResource Brush.PrimaryGradient}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimary}"/>
  </Style>
  <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.9"/>
  </Style>

  <Style Selector="Button.Secondary">
    <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style Selector="Button.Destructive">
    <Setter Property="Background" Value="{StaticResource Color.BrandRed}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>

  <Style Selector="Button.Ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource BrandPrimary}"/>
  </Style>

  <Style Selector="Button.SmallButton">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>

  <Style Selector="Button.IconButton">
    <Setter Property="Padding" Value="8"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="Button.CopyPill">
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- INPUTS                                                          -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource InputText}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- PROGRESS BAR                                                    -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="8"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.ProgressGradient}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceInset}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- TOAST NOTIFICATION                                              -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="Border.Toast">
    <Setter Property="Background" Value="{DynamicResource ToastBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ToastBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Padding" Value="16,8"/>
  </Style>

</Styles>
