<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- STATIC BRAND GRADIENTS & ACCENTS                                -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="Color.BrandCyan" Color="#00C7BE"/>
  <SolidColorBrush x:Key="Color.BrandBlue" Color="#007AFF"/>
  <SolidColorBrush x:Key="Color.BrandPurple" Color="#AF52DE"/>
  <SolidColorBrush x:Key="Color.BrandIndigo" Color="#5856D6"/>
  <SolidColorBrush x:Key="Color.BrandPink" Color="#FF2D55"/>
  <SolidColorBrush x:Key="Color.BrandEmerald" Color="#34C759"/>
  <SolidColorBrush x:Key="Color.BrandAmber" Color="#FF9500"/>
  <SolidColorBrush x:Key="Color.BrandRed" Color="#FF3B30"/>

  <LinearGradientBrush x:Key="Brush.PrimaryGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#007AFF" Offset="0"/>
    <GradientStop Color="#5856D6" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.HeaderLogoGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#00C7BE" Offset="0"/>
    <GradientStop Color="#007AFF" Offset="0.5"/>
    <GradientStop Color="#AF52DE" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.ProgressGradient" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Color="#64D2FF" Offset="0"/>
    <GradientStop Color="#0A84FF" Offset="0.5"/>
    <GradientStop Color="#BF5AF2" Offset="1"/>
  </LinearGradientBrush>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- SPACING & RADIUS TOKENS                                         -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <x:Double x:Key="Spacing.XS">4</x:Double>
  <x:Double x:Key="Spacing.SM">8</x:Double>
  <x:Double x:Key="Spacing.MD">12</x:Double>
  <x:Double x:Key="Spacing.LG">16</x:Double>
  <x:Double x:Key="Spacing.XL">20</x:Double>
  <x:Double x:Key="Spacing.XXL">24</x:Double>
  <x:Double x:Key="Spacing.XXXL">32</x:Double>

  <CornerRadius x:Key="CornerRadius.Card">16</CornerRadius>
  <CornerRadius x:Key="CornerRadius.Inset">12</CornerRadius>
  <CornerRadius x:Key="CornerRadius.Pill">999</CornerRadius>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- THEME DICTIONARIES (LIGHT & DARK DYNAMIC RESOURCES)            -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <ResourceDictionary.ThemeDictionaries>
    <!-- ═══════════ LIGHT THEME ═══════════ -->
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="SurfaceBackground" Color="#F8FAFC"/>
      <SolidColorBrush x:Key="SurfaceCard" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SurfaceCardHover" Color="#F1F5F9"/>
      <SolidColorBrush x:Key="SurfaceInset" Color="#F1F5F9"/>
      <SolidColorBrush x:Key="SurfaceElevated" Color="#FFFFFF"/>

      <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
      <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
      <SolidColorBrush x:Key="TextTertiary" Color="#94A3B8"/>
      <SolidColorBrush x:Key="TextDisabled" Color="#CBD5E1"/>

      <SolidColorBrush x:Key="BorderSubtle" Color="#E2E8F0"/>
      <SolidColorBrush x:Key="BorderStrong" Color="#CBD5E1"/>

      <SolidColorBrush x:Key="BrandPrimary" Color="#007AFF"/>
      <SolidColorBrush x:Key="BrandOnPrimary" Color="#FFFFFF"/>

      <SolidColorBrush x:Key="ButtonSecondaryBg" Color="#F1F5F9"/>
      <SolidColorBrush x:Key="ButtonSecondaryBorder" Color="#E2E8F0"/>
      <SolidColorBrush x:Key="ButtonSecondaryText" Color="#0F172A"/>

      <SolidColorBrush x:Key="InputBackground" Color="#F1F5F9"/>
      <SolidColorBrush x:Key="InputBorder" Color="#E2E8F0"/>
      <SolidColorBrush x:Key="InputText" Color="#0F172A"/>
      <SolidColorBrush x:Key="InputWatermark" Color="#94A3B8"/>

      <SolidColorBrush x:Key="ToastBackground" Color="#EE0F172A"/>
      <SolidColorBrush x:Key="ToastBorder" Color="#38BDF8"/>
      <SolidColorBrush x:Key="ToastText" Color="#FFFFFF"/>

      <SolidColorBrush x:Key="WarningContainer" Color="#FFF7ED"/>
      <SolidColorBrush x:Key="WarningBorder" Color="#F59E0B"/>
      <SolidColorBrush x:Key="WarningText" Color="#9A3412"/>

      <SolidColorBrush x:Key="IconPrimary" Color="#0F172A"/>
      <SolidColorBrush x:Key="IconMuted" Color="#94A3B8"/>
    </ResourceDictionary>

    <!-- ═══════════ DARK THEME ═══════════ -->
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="SurfaceBackground" Color="#0B0E14"/>
      <SolidColorBrush x:Key="SurfaceCard" Color="#161B26"/>
      <SolidColorBrush x:Key="SurfaceCardHover" Color="#1E2433"/>
      <SolidColorBrush x:Key="SurfaceInset" Color="#1E2433"/>
      <SolidColorBrush x:Key="SurfaceElevated" Color="#283044"/>

      <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
      <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
      <SolidColorBrush x:Key="TextTertiary" Color="#64748B"/>
      <SolidColorBrush x:Key="TextDisabled" Color="#475569"/>

      <SolidColorBrush x:Key="BorderSubtle" Color="#2A3245"/>
      <SolidColorBrush x:Key="BorderStrong" Color="#3B4660"/>

      <SolidColorBrush x:Key="BrandPrimary" Color="#0A84FF"/>
      <SolidColorBrush x:Key="BrandOnPrimary" Color="#FFFFFF"/>

      <SolidColorBrush x:Key="ButtonSecondaryBg" Color="#1E2433"/>
      <SolidColorBrush x:Key="ButtonSecondaryBorder" Color="#2A3245"/>
      <SolidColorBrush x:Key="ButtonSecondaryText" Color="#F8FAFC"/>

      <SolidColorBrush x:Key="InputBackground" Color="#1E2433"/>
      <SolidColorBrush x:Key="InputBorder" Color="#2A3245"/>
      <SolidColorBrush x:Key="InputText" Color="#F8FAFC"/>
      <SolidColorBrush x:Key="InputWatermark" Color="#64748B"/>

      <SolidColorBrush x:Key="ToastBackground" Color="#EE1E293B"/>
      <SolidColorBrush x:Key="ToastBorder" Color="#0EA5E9"/>
      <SolidColorBrush x:Key="ToastText" Color="#F8FAFC"/>

      <SolidColorBrush x:Key="WarningContainer" Color="#2A1C08"/>
      <SolidColorBrush x:Key="WarningBorder" Color="#F59E0B"/>
      <SolidColorBrush x:Key="WarningText" Color="#FDE68A"/>

      <SolidColorBrush x:Key="IconPrimary" Color="#F8FAFC"/>
      <SolidColorBrush x:Key="IconMuted" Color="#64748B"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
