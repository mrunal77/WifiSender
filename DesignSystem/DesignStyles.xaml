<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- TYPOGRAPHY                                                      -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="Inter, SF Pro Display, Segoe UI, Roboto, sans-serif"/>
    <Setter Property="Foreground" Value="{StaticResource Color.TextPrimary}"/>
  </Style>
  <Style Selector=":dark TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Color.DarkTextPrimary}"/>
  </Style>

  <Style Selector="TextBlock.HeroTitle">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="-0.3"/>
  </Style>

  <Style Selector="TextBlock.HeroSubtitle">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource Color.TextSecondary}"/>
  </Style>
  <Style Selector=":dark TextBlock.HeroSubtitle">
    <Setter Property="Foreground" Value="{StaticResource Color.DarkTextSecondary}"/>
  </Style>

  <Style Selector="TextBlock.Heading">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="-0.1"/>
  </Style>
  <Style Selector=":dark TextBlock.Heading">
    <Setter Property="Foreground" Value="{StaticResource Color.DarkTextPrimary}"/>
  </Style>

  <Style Selector="TextBlock.Caption">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource Color.TextSecondary}"/>
  </Style>
  <Style Selector=":dark TextBlock.Caption">
    <Setter Property="Foreground" Value="{StaticResource Color.DarkTextSecondary}"/>
  </Style>

  <Style Selector="TextBlock.Small">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource Color.TextSecondary}"/>
  </Style>
  <Style Selector=":dark TextBlock.Small">
    <Setter Property="Foreground" Value="{StaticResource Color.DarkTextSecondary}"/>
  </Style>

  <Style Selector="TextBlock.BadgeText">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="0.5"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- CARDS & CONTAINERS                                              -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{StaticResource Color.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Card}"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
        <BrushTransition Property="Background" Duration="0:0:0.2"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":dark Border.Card">
    <Setter Property="Background" Value="{StaticResource Color.DarkSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.DarkBorder}"/>
  </Style>

  <Style Selector="Border.Inset">
    <Setter Property="Background" Value="{StaticResource Color.SurfaceVariant}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Inset}"/>
    <Setter Property="Padding" Value="10"/>
  </Style>
  <Style Selector=":dark Border.Inset">
    <Setter Property="Background" Value="{StaticResource Color.DarkSurfaceVariant}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.DarkBorder}"/>
  </Style>

  <Style Selector="Border.GlassCard">
    <Setter Property="Background" Value="#0D000000"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Card}"/>
    <Setter Property="Padding" Value="16"/>
  </Style>
  <Style Selector=":dark Border.GlassCard">
    <Setter Property="Background" Value="#1AFFFFFF"/>
    <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
  </Style>

  <Style Selector="Border.Warning">
    <Setter Property="Background" Value="{StaticResource Color.WarningContainer}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.Warning}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Inset}"/>
    <Setter Property="Padding" Value="12,10"/>
  </Style>
  <Style Selector=":dark Border.Warning">
    <Setter Property="Background" Value="#2A1B00"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.WarningDark}"/>
  </Style>

  <!-- Status Dot -->
  <Style Selector="Border.StatusDot">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Background" Value="{StaticResource Color.Success}"/>
  </Style>
  <Style Selector=":dark Border.StatusDot">
    <Setter Property="Background" Value="{StaticResource Color.SuccessDark}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- BUTTONS                                                         -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="Inter, sans-serif"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>

  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{StaticResource Brush.PrimaryGradient}"/>
    <Setter Property="Foreground" Value="{StaticResource Color.OnPrimary}"/>
  </Style>
  <Style Selector=":dark Button.Primary">
    <Setter Property="Background" Value="{StaticResource Brush.PrimaryGradientDark}"/>
  </Style>
  <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.9"/>
  </Style>

  <Style Selector="Button.Secondary">
    <Setter Property="Background" Value="{StaticResource Color.SurfaceVariant}"/>
    <Setter Property="Foreground" Value="{StaticResource Color.TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector=":dark Button.Secondary">
    <Setter Property="Background" Value="{StaticResource Color.DarkSurfaceVariant}"/>
    <Setter Property="Foreground" Value="{StaticResource Color.DarkTextPrimary}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.DarkBorder}"/>
  </Style>

  <Style Selector="Button.Destructive">
    <Setter Property="Background" Value="{StaticResource Color.Error}"/>
    <Setter Property="Foreground" Value="{StaticResource Color.OnPrimary}"/>
  </Style>
  <Style Selector=":dark Button.Destructive">
    <Setter Property="Background" Value="{StaticResource Color.ErrorDark}"/>
  </Style>

  <Style Selector="Button.Ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Color.Primary}"/>
  </Style>
  <Style Selector=":dark Button.Ghost">
    <Setter Property="Foreground" Value="{StaticResource Color.PrimaryDark}"/>
  </Style>

  <Style Selector="Button.SmallButton">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>

  <Style Selector="Button.IconButton">
    <Setter Property="Padding" Value="8"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="Button.CopyPill">
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Background" Value="{StaticResource Color.SurfaceVariant}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector=":dark Button.CopyPill">
    <Setter Property="Background" Value="{StaticResource Color.DarkSurfaceVariant}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.DarkBorder}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- INPUTS                                                          -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="{StaticResource Color.SurfaceVariant}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector=":dark TextBox">
    <Setter Property="Background" Value="{StaticResource Color.DarkSurfaceVariant}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.DarkBorder}"/>
    <Setter Property="Foreground" Value="{StaticResource Color.DarkTextPrimary}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- PROGRESS BAR                                                    -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="8"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.ProgressGradient}"/>
    <Setter Property="Background" Value="{StaticResource Color.SurfaceVariant}"/>
  </Style>
  <Style Selector=":dark ProgressBar">
    <Setter Property="Background" Value="{StaticResource Color.DarkSurfaceVariant}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- TOAST NOTIFICATION                                              -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <Style Selector="Border.Toast">
    <Setter Property="Background" Value="#E60F172A"/>
    <Setter Property="BorderBrush" Value="#38BDF8"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Padding" Value="16,8"/>
  </Style>
  <Style Selector=":dark Border.Toast">
    <Setter Property="Background" Value="#E61E293B"/>
    <Setter Property="BorderBrush" Value="#0EA5E9"/>
  </Style>

</Styles>
