<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="using:WifiSender.ViewModels"
         xmlns:conv="using:WifiSender.Converters"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="620"
         x:Class="WifiSender.Views.MainWindow"
         x:DataType="vm:MainWindowViewModel"
         Title="WifiSender"
         Width="820" Height="650"
         SizeToContent="Manual"
         CanResize="False"
         MinWidth="720" MinHeight="560"
         FontFamily="Inter"
         Icon="/Assets/appicon.ico">
    <Window.Transitions>
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25"/>
      </Transitions>
    </Window.Transitions>

  <Window.Resources>
    <!-- Material Design Icons (Apache 2.0) -->
    <StreamGeometry x:Key="IconWifi">M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
    <StreamGeometry x:Key="IconDelete">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
    <StreamGeometry x:Key="IconUpload">M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z</StreamGeometry>
    <StreamGeometry x:Key="IconDownload">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
    <StreamGeometry x:Key="IconStop">M6 6h12v12H6z</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
    <StreamGeometry x:Key="IconDevice">M20 18c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z</StreamGeometry>
    <StreamGeometry x:Key="IconFile">M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13z</StreamGeometry>
    <StreamGeometry x:Key="IconWrench">M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.Heading">
      <Setter Property="FontFamily" Value="Inter"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="0.2"/>
    </Style>
    <Style Selector="TextBlock.Caption">
      <Setter Property="FontFamily" Value="Inter"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.Small">
      <Setter Property="FontFamily" Value="Inter"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.HeroTitle">
      <Setter Property="FontFamily" Value="Inter"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.HeroSubtitle">
      <Setter Property="FontFamily" Value="Inter"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.PillLabel">
      <Setter Property="FontFamily" Value="Inter"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.PillValue">
      <Setter Property="FontFamily" Value="Inter"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Inter"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
          <BrushTransition Property="Background" Duration="0:0:0.18"/>
          <ThicknessTransition Property="BorderThickness" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button.Primary">
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.Secondary">
      <Setter Property="Foreground" Value="#7C3AED"/>
    </Style>
    <Style Selector="Button.Ghost">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.SmallButton">
      <Setter Property="MinWidth" Value="72"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="CornerRadius" Value="11"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Inter"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Height" Value="8"/>
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Separator">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="Border.Card, Border.Inset, Border.Pill, Border.Warning">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.25"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.Logo">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#F97316" Offset="0"/>
          <GradientStop Color="#EC4899" Offset="0.4"/>
          <GradientStop Color="#7C3AED" Offset="0.75"/>
          <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="PathIcon">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
    </Style>

    <Style Selector=":dark Window">
      <Setter Property="Background" Value="#0F0C29"/>
    </Style>
    <Style Selector=":dark TextBlock">
      <Setter Property="Foreground" Value="#E5E7EB"/>
    </Style>
    <Style Selector=":dark TextBlock.Heading">
      <Setter Property="Foreground" Value="#F8FAFC"/>
    </Style>
    <Style Selector=":dark TextBlock.Caption">
      <Setter Property="Foreground" Value="#C4B5FD"/>
    </Style>
    <Style Selector=":dark TextBlock.Small">
      <Setter Property="Foreground" Value="#A5B4FC"/>
    </Style>
    <Style Selector=":dark TextBlock.HeroSubtitle">
      <Setter Property="Foreground" Value="#CBD5E1"/>
    </Style>
    <Style Selector=":dark TextBlock.PillLabel">
      <Setter Property="Foreground" Value="#F0ABFC"/>
    </Style>
    <Style Selector=":dark TextBlock.PillValue">
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector=":dark Button">
      <Setter Property="Background" Value="#1E1B4B"/>
      <Setter Property="Foreground" Value="#E2E8F0"/>
      <Setter Property="BorderBrush" Value="#312E81"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector=":dark Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#312E81"/>
      <Setter Property="BorderBrush" Value="#4C1D95"/>
    </Style>
    <Style Selector=":dark Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E1B4B"/>
    </Style>
    <Style Selector=":dark Button.Primary">
      <Setter Property="Background" Value="#7C3AED"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector=":dark Button.Primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#8B5CF6"/>
    </Style>
    <Style Selector=":dark Button.Send">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#F97316" Offset="0"/>
          <GradientStop Color="#EC4899" Offset="0.5"/>
          <GradientStop Color="#F59E0B" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector=":dark Button.Send:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FB923C"/>
    </Style>
    <Style Selector=":dark Button.Receive">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#10B981" Offset="0"/>
          <GradientStop Color="#06B6D4" Offset="0.5"/>
          <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector=":dark Button.Receive:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#34D399"/>
    </Style>
    <Style Selector=":dark Button.Secondary">
      <Setter Property="Background" Value="#1E1B4B"/>
      <Setter Property="Foreground" Value="#C4B5FD"/>
      <Setter Property="BorderBrush" Value="#312E81"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector=":dark Button.Secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#312E81"/>
      <Setter Property="BorderBrush" Value="#4C1D95"/>
    </Style>
    <Style Selector=":dark Button.Destructive">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#EF4444" Offset="0"/>
          <GradientStop Color="#DC2626" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector=":dark Button.Destructive:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F87171"/>
    </Style>
    <Style Selector=":dark Button.Ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#CBD5E1"/>
    </Style>
    <Style Selector=":dark Button.Ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#312E81"/>
    </Style>
    <Style Selector=":dark TextBox">
      <Setter Property="Background" Value="#1E1B4B"/>
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="#4C1D95"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style Selector=":dark TextBox:focus">
      <Setter Property="BorderBrush" Value="#A78BFA"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector=":dark TextBox:pointerover">
      <Setter Property="BorderBrush" Value="#7C3AED"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style Selector=":dark ListBoxItem:selected">
      <Setter Property="Background" Value="#312E81"/>
    </Style>
    <Style Selector=":dark ListBoxItem:pointerover">
      <Setter Property="Background" Value="#4C1D95"/>
    </Style>
    <Style Selector=":dark ProgressBar">
      <Setter Property="Background" Value="#1E1B4B"/>
      <Setter Property="Foreground">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Color="#F59E0B" Offset="0"/>
          <GradientStop Color="#EC4899" Offset="0.5"/>
          <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector=":dark Separator">
      <Setter Property="Background" Value="#4C1D95"/>
      <Setter Property="Height" Value="1.5"/>
    </Style>
    <Style Selector=":dark Border.Card">
      <Setter Property="Background" Value="#1A1640"/>
      <Setter Property="BorderBrush">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#7C3AED" Offset="0"/>
          <GradientStop Color="#EC4899" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style Selector=":dark Border.Inset">
      <Setter Property="Background" Value="#150F2E"/>
      <Setter Property="BorderBrush" Value="#4C1D95"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector=":dark Border.Pill">
      <Setter Property="Background" Value="#1A1640"/>
      <Setter Property="BorderBrush">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#A78BFA" Offset="0"/>
          <GradientStop Color="#F0ABFC" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector=":dark Border.Warning">
      <Setter Property="Background" Value="#2D1B0E"/>
      <Setter Property="BorderBrush" Value="#F59E0B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>
    <Style Selector=":dark Border.WarningIcon">
      <Setter Property="Background" Value="#F59E0B"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
    </Style>
    <Style Selector=":dark Border.StatusDot">
      <Setter Property="Background" Value="#34D399"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Width" Value="7"/>
      <Setter Property="Height" Value="7"/>
    </Style>
    <Style Selector=":dark PathIcon">
      <Setter Property="Foreground" Value="#C4B5FD"/>
    </Style>

    <Style Selector=":light Window">
      <Setter Property="Background" Value="#FDF2F8"/>
    </Style>
    <Style Selector=":light TextBlock">
      <Setter Property="Foreground" Value="#334155"/>
    </Style>
    <Style Selector=":light TextBlock.Heading">
      <Setter Property="Foreground" Value="#0F172A"/>
    </Style>
    <Style Selector=":light TextBlock.Caption">
      <Setter Property="Foreground" Value="#7C3AED"/>
    </Style>
    <Style Selector=":light TextBlock.Small">
      <Setter Property="Foreground" Value="#6D28D9"/>
    </Style>
    <Style Selector=":light TextBlock.HeroSubtitle">
      <Setter Property="Foreground" Value="#475569"/>
    </Style>
    <Style Selector=":light TextBlock.PillLabel">
      <Setter Property="Foreground" Value="#9333EA"/>
    </Style>
    <Style Selector=":light TextBlock.PillValue">
      <Setter Property="Foreground" Value="#0F172A"/>
    </Style>
    <Style Selector=":light Button">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1E293B"/>
      <Setter Property="BorderBrush" Value="#E9D5FF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector=":light Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3E8FF"/>
      <Setter Property="BorderBrush" Value="#D8B4FE"/>
    </Style>
    <Style Selector=":light Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#E9D5FF"/>
    </Style>
    <Style Selector=":light Button.Primary">
      <Setter Property="Background" Value="#7C3AED"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector=":light Button.Primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#6D28D9"/>
    </Style>
    <Style Selector=":light Button.Send">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#FB923C" Offset="0"/>
          <GradientStop Color="#F472B6" Offset="0.5"/>
          <GradientStop Color="#FBBF24" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector=":light Button.Send:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F97316"/>
    </Style>
    <Style Selector=":light Button.Receive">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#34D399" Offset="0"/>
          <GradientStop Color="#22D3EE" Offset="0.5"/>
          <GradientStop Color="#60A5FA" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector=":light Button.Receive:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#10B981"/>
    </Style>
    <Style Selector=":light Button.Secondary">
      <Setter Property="Background" Value="#FAF5FF"/>
      <Setter Property="Foreground" Value="#7C3AED"/>
      <Setter Property="BorderBrush" Value="#E9D5FF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector=":light Button.Secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3E8FF"/>
      <Setter Property="BorderBrush" Value="#D8B4FE"/>
    </Style>
    <Style Selector=":light Button.Destructive">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#F87171" Offset="0"/>
          <GradientStop Color="#EF4444" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector=":light Button.Destructive:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#DC2626"/>
    </Style>
    <Style Selector=":light Button.Ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#64748B"/>
    </Style>
    <Style Selector=":light Button.Ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC"/>
    </Style>
    <Style Selector=":light TextBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#C4B5FD"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style Selector=":light TextBox:focus">
      <Setter Property="BorderBrush" Value="#9333EA"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector=":light TextBox:pointerover">
      <Setter Property="BorderBrush" Value="#A78BFA"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style Selector=":light ListBoxItem:selected">
      <Setter Property="Background" Value="#E9D5FF"/>
    </Style>
    <Style Selector=":light ListBoxItem:pointerover">
      <Setter Property="Background" Value="#F3E8FF"/>
    </Style>
    <Style Selector=":light ProgressBar">
      <Setter Property="Background" Value="#E9D5FF"/>
      <Setter Property="Foreground">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Color="#F59E0B" Offset="0"/>
          <GradientStop Color="#EC4899" Offset="0.5"/>
          <GradientStop Color="#7C3AED" Offset="1"/>
