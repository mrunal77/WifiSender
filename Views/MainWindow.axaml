<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="using:WifiSender.ViewModels"
         xmlns:conv="using:WifiSender.Converters"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="620"
         x:Class="WifiSender.Views.MainWindow"
         x:DataType="vm:MainWindowViewModel"
         Title="WifiSender"
         Width="820" Height="650"
         SizeToContent="Manual"
         CanResize="False"
         MinWidth="720" MinHeight="560"
         FontFamily="Inter"
         Icon="/Assets/appicon.ico">
    <Window.Transitions>
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25"/>
      </Transitions>
    </Window.Transitions>

  <Window.Resources>
    <StreamGeometry x:Key="IconWifi">M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
    <StreamGeometry x:Key="IconDelete">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
    <StreamGeometry x:Key="IconUpload">M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z</StreamGeometry>
    <StreamGeometry x:Key="IconDownload">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
    <StreamGeometry x:Key="IconStop">M6 6h12v12H6z</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
    <StreamGeometry x:Key="IconDevice">M20 18c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z</StreamGeometry>
    <StreamGeometry x:Key="IconFile">M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13z</StreamGeometry>
    <StreamGeometry x:Key="IconWrench">M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z</StreamGeometry>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="24,18,24,22">
      <Border.Styles>
        <Style Selector=":dark Border">
          <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="#1C1C1E" Offset="0"/>
              <GradientStop Color="#000000" Offset="1"/>
            </LinearGradientBrush>
          </Setter>
        </Style>
        <Style Selector=":light Border">
          <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="#FFFFFF" Offset="0"/>
              <GradientStop Color="#F5F5F7" Offset="1"/>
            </LinearGradientBrush>
          </Setter>
        </Style>
      </Border.Styles>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Classes="Logo">
            <PathIcon Data="{StaticResource IconWifi}" Width="18" Height="18" Foreground="#FFFFFF"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="WifiSender" Classes="HeroTitle"/>
            <TextBlock Text="Fast WiFi file transfer" Classes="HeroSubtitle"/>
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="2" Classes="Pill">
          <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
            <Border Classes="StatusDot" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Local IP" Classes="PillLabel"/>
              <TextBlock Text="{Binding LocalIp}" Classes="PillValue"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Opacity="{Binding ContentOpacity}" Padding="0" Background="Transparent" Classes="ContentArea">
      <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2"/></Transitions></Border.Transitions>

    <TabControl x:Name="MainTabControl" SelectedIndex="{Binding SelectedTabIndex}" Margin="24,18,0,24">
      <TabControl.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions></TabControl.Transitions>

      <!-- ═══════════ SEND TAB ═══════════ -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconUpload}" Width="14" Height="14" VerticalAlignment="Center"/>
            <TextBlock Text="Send Files" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer x:Name="SendScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16" Margin="0,16,20,0"
                VerticalAlignment="Top" MinHeight="400">

            <!-- Firewall Warning -->
            <Border Grid.Row="0" Classes="Warning" IsVisible="{Binding IsFirewallWarningVisible}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Classes="WarningIcon">
                  <TextBlock Text="!" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding FirewallWarningText}"
                           TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/>
                <Button Grid.Column="2" Command="{Binding FixFirewallCommand}"
                        Classes="Ghost SmallButton" VerticalAlignment="Center" ToolTip.Tip="Fix firewall">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconWrench}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="Fix" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <!-- Connection Card -->
            <Border Grid.Row="1" Classes="Card">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <PathIcon Data="{StaticResource IconSearch}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Connection" Classes="Heading" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" Command="{Binding ScanDevicesCommand}"
                          IsEnabled="{Binding !IsScanning}" Classes="Primary SmallButton" VerticalAlignment="Center"
                          ToolTip.Tip="Scan for nearby devices">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource IconSearch}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Opacity="{Binding IsScanning, Converter={x:Static conv:BoolToOpacity.Instance}}"/>
                      <TextBlock Text="Scan" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>

                <TextBox Grid.Row="1" Text="{Binding Port}" MinWidth="100" MaxWidth="120"
                         HorizontalAlignment="Left" MaxLength="5"/>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Text="Receiver IPs" Classes="Caption" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" Text="{Binding SelectedDeviceIp, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                           Watermark="Select a device or enter IP manually"/>
                  <Button Grid.Column="2" Command="{Binding TestConnectionCommand}"
                          Classes="Secondary SmallButton" VerticalAlignment="Top" ToolTip.Tip="Test all receiver connections">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource IconPlay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Text="Test" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>

                <TextBlock Grid.Row="3" Text="{Binding ConnectionTestResult}" Classes="Small" IsVisible="{Binding HasConnectionTestResult}" TextWrapping="Wrap"/>

                <Border Grid.Row="4" IsVisible="{Binding HasDiscoveredDevices}" Classes="Inset" Padding="10" MinHeight="60" MaxHeight="180">
                  <ListBox ItemsSource="{Binding DiscoveredDevices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                          <Border Classes="Inset" CornerRadius="9" Width="32" Height="32">
                            <PathIcon Data="{StaticResource IconDevice}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                            <TextBlock Text="{Binding IpAddress}" Classes="Small"/>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>

                <Button Grid.Row="5" Command="{Binding SelectDeviceCommand}" CommandParameter="{Binding SelectedDevice}"
                        Classes="Secondary SmallButton" HorizontalAlignment="Center"
                        IsEnabled="{Binding SelectedDevice, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="Select this device">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconCheck}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="Select" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <!-- Files Card -->
            <Border Grid.Row="2" Classes="Card">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                  <PathIcon Data="{StaticResource IconFolder}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Files" Classes="Heading" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" Command="{Binding SelectFilesCommand}"
                          CommandParameter="{Binding $parent[Window]}" Classes="Secondary SmallButton" VerticalAlignment="Center"
                          ToolTip.Tip="Add files to send">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource IconFile}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Text="Add Files" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="3" Command="{Binding SelectFolderCommand}"
                          CommandParameter="{Binding $parent[Window]}" Classes="Secondary SmallButton" VerticalAlignment="Center"
                          ToolTip.Tip="Add folder to send">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource IconFolder}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Text="Add Folder" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="4" Command="{Binding ClearFilesCommand}"
                          Classes="Ghost SmallButton" VerticalAlignment="Center" ToolTip.Tip="Clear selected files">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource IconDelete}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Text="Clear" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>

                <Border Grid.Row="1" Classes="Inset" MinHeight="60" MaxHeight="150" IsVisible="{Binding HasSelectedFiles}">
                  <ListBox ItemsSource="{Binding SelectedFiles}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <Border Classes="Inset" CornerRadius="10" Width="34" Height="34">
                            <PathIcon Data="{StaticResource IconFile}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>
              </Grid>
            </Border>

            <!-- Send Action -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" HorizontalAlignment="Center">
              <Button Command="{Binding SendFilesCommand}" CommandParameter="{Binding $parent[Window]}"
                      Classes="Primary Send" HorizontalAlignment="Stretch" MinWidth="160" Padding="24,14"
                      CornerRadius="10" ToolTip.Tip="Send files (Enter)"
                      IsVisible="{Binding !IsSending}">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource IconUpload}" Width="20" Height="20"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="Send Selected Files" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Command="{Binding StopSendingCommand}"
                      Classes="Destructive" HorizontalAlignment="Stretch" MinWidth="160" Padding="24,14"
                      CornerRadius="10"
                      IsVisible="{Binding IsSending}">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource IconStop}" Width="20" Height="20"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="Stop Sending" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>

            <!-- Progress -->
            <Border Grid.Row="4" Classes="Inset" IsVisible="{Binding IsSending}">
              <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Status}" Classes="Small" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding CurrentFileProgress}" FontSize="11" FontWeight="SemiBold"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding CurrentFileName}" Classes="Small" TextTrimming="CharacterEllipsis" FontStyle="Italic"
                           IsVisible="{Binding HasCurrentFile}"/>
                <ProgressBar Grid.Row="2" Value="{Binding Progress}" Minimum="0" Maximum="100"/>
              </Grid>
            </Border>

          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- ═══════════ RECEIVE TAB ═══════════ -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconDownload}" Width="14" Height="14" VerticalAlignment="Center"/>
            <TextBlock Text="Receive Files" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer x:Name="ReceiveScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16" Margin="0,16,20,0"
                VerticalAlignment="Top" MinHeight="400">

            <!-- Connection Info Card -->
            <Border Grid.Row="0" Classes="Card">
              <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                  <PathIcon Grid.Column="0" Data="{StaticResource IconDownload}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Connection Info" Classes="Heading" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="10">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Your IP" Classes="Caption" VerticalAlignment="Center"/>
                    <Border Grid.Row="0" Grid.Column="1" Classes="Inset" Padding="10,8" HorizontalAlignment="Left" MinWidth="150">
                      <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                        <Border Classes="StatusDot" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding LocalIp}" FontWeight="SemiBold" FontSize="13"/>
                      </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Port number" Classes="Caption" VerticalAlignment="Center"/>
                    <Border Grid.Row="1" Grid.Column="1" Classes="Inset" Padding="10,8" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Port}" FontWeight="SemiBold" FontSize="13"/>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Classes="Inset" Padding="10">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <PathIcon Data="{StaticResource IconDownload}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Share the IP and port above with the sender"
                              Classes="Small" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <!-- Save Location Card -->
            <Border Grid.Row="1" Classes="Card">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                 <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                   <PathIcon Grid.Column="0" Data="{StaticResource IconFolder}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Save Location" Classes="Heading" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" Command="{Binding SelectDownloadFolderCommand}"
                          CommandParameter="{Binding $parent[Window]}" Classes="Secondary SmallButton" VerticalAlignment="Center"
                          ToolTip.Tip="Change download folder">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource IconFolder}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Text="Change" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>

                <Border Grid.Row="1" Classes="Inset" Padding="10">
                  <TextBlock Text="{Binding DownloadFolder, FallbackValue='Default: ~/Downloads'}"
                             FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Border>

            <!-- Action Buttons -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" VerticalAlignment="Center">
              <Button Command="{Binding ToggleReceivingCommand}" CommandParameter="{Binding $parent[Window]}"
                      Classes="Primary Receive" HorizontalAlignment="Stretch" Padding="20,14" CornerRadius="10"
                      IsVisible="{Binding !IsReceiving}">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource IconPlay}" Width="20" Height="20"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="Start Receiving" FontSize="14" FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding ToggleReceivingCommand}"
                      Classes="Destructive" HorizontalAlignment="Stretch" Padding="20,14" CornerRadius="10"
                      IsVisible="{Binding IsReceiving}">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource IconStop}" Width="20" Height="20"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="Stop Receiving" FontSize="14" FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>

            <!-- Progress -->
            <Border Grid.Row="3" Classes="Inset" IsVisible="{Binding IsReceiving}">
              <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Status}" Classes="Small" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding CurrentFileProgress}" FontSize="11" FontWeight="SemiBold"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding CurrentFileName}" Classes="Small" TextTrimming="CharacterEllipsis" FontStyle="Italic"
                           IsVisible="{Binding HasCurrentFile}"/>
                <ProgressBar Grid.Row="2" Value="{Binding Progress}" Minimum="0" Maximum="100"/>
              </Grid>
            </Border>

          </Grid>
        </ScrollViewer>
      </TabItem>

    </TabControl>
    </Border>
  </DockPanel>

</Window>
