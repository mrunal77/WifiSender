    </Style>
    <Style Selector=":light Border.Card">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#7C3AED" Offset="0"/>
